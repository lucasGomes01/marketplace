# Copie para .env (não versionado). Valores apenas para desenvolvimento local.
MSSQL_SA_PASSWORD=Dev_Local_Passw0rd!
# Mínimo de 32 caracteres. Gere uma chave própria para qualquer ambiente fora da sua máquina.
JWT_SIGNING_KEY=dev-only-signing-key-change-me-0123456789
# Cifra o número do cartão de recebimento dos vendedores (AES-256): base64 de 32 bytes. Gere com: openssl rand -base64 32
PAYMENTS_CARD_ENCRYPTION_KEY=ZGV2LW9ubHktY2FyZC1rZXktY2hhbmdlLW1lLTAwMDA=
# Simulated (sem credenciais) ou Mastercard (sandbox do developer.mastercard.com; chave em ./secrets, ver ADR-006)
PAYMENTS_PROVIDER=Simulated
# MASTERCARD_CONSUMER_KEY=
# MASTERCARD_SIGNING_KEY_PATH=/secrets/mastercard-sandbox.p12
# MASTERCARD_SIGNING_KEY_PASSWORD=
# MASTERCARD_PARTNER_ID=
