{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "marketplace-users",
    "Audience": "marketplace",
    "ExpirationMinutes": 60
  },
  "Payments": {
    "Provider": "Simulated",
    "ExchangeRateCacheMinutes": 60
  },
  "Payouts": {
    "FeeRate": 0.10,
    "HoldDays": 0,
    "RetryDelaySeconds": 60,
    "DispatchIntervalSeconds": 5,
    "BatchSize": 20
  },
  "Mastercard": {
    "BaseUrl": "https://sandbox.api.mastercard.com",
    "OriginationCountry": "BRA"
  }
}
