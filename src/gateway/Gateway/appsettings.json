{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "Origins": [
      "http://localhost:5173"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "users": {
        "ClusterId": "users",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "auth": {
        "ClusterId": "users",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "products": {
        "ClusterId": "catalog",
        "OutputCachePolicy": "catalog-public",
        "Match": {
          "Path": "/api/products/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "cart": {
        "ClusterId": "cart",
        "Match": {
          "Path": "/api/cart/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "orders": {
        "ClusterId": "orders",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "shipments": {
        "ClusterId": "orders",
        "Match": {
          "Path": "/api/shipments/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "health-users": {
        "ClusterId": "users",
        "Match": {
          "Path": "/health/users"
        },
        "Transforms": [
          {
            "PathSet": "/health"
          }
        ]
      },
      "health-catalog": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/health/catalog"
        },
        "Transforms": [
          {
            "PathSet": "/health"
          }
        ]
      },
      "health-cart": {
        "ClusterId": "cart",
        "Match": {
          "Path": "/health/cart"
        },
        "Transforms": [
          {
            "PathSet": "/health"
          }
        ]
      },
      "health-orders": {
        "ClusterId": "orders",
        "Match": {
          "Path": "/health/orders"
        },
        "Transforms": [
          {
            "PathSet": "/health"
          }
        ]
      }
    },
    "Clusters": {
      "users": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5001/"
          }
        }
      },
      "catalog": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5002/"
          }
        }
      },
      "cart": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5003/"
          }
        }
      },
      "orders": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5004/"
          }
        }
      }
    }
  }
}
