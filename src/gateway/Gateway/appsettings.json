{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "Origins": [ "http://localhost:5173" ]
  },
  "ReverseProxy": {
    "Routes": {
      "users": {
        "ClusterId": "users",
        "Match": { "Path": "/api/users/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/users" } ]
      },
      "catalog": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/catalog/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/catalog" } ]
      },
      "cart": {
        "ClusterId": "cart",
        "Match": { "Path": "/api/cart/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/cart" } ]
      },
      "orders": {
        "ClusterId": "orders",
        "Match": { "Path": "/api/orders/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/orders" } ]
      }
    },
    "Clusters": {
      "users":   { "Destinations": { "d1": { "Address": "http://localhost:5001/" } } },
      "catalog": { "Destinations": { "d1": { "Address": "http://localhost:5002/" } } },
      "cart":    { "Destinations": { "d1": { "Address": "http://localhost:5003/" } } },
      "orders":  { "Destinations": { "d1": { "Address": "http://localhost:5004/" } } }
    }
  }
}
